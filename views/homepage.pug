doctype html
html(lang="en")
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Custom Objects Table
        a(href="/update-cobj") Add to this table
        table
            thead
                tr
                    th Name
                    th Author
                    th Genre
            tbody
                each item in data
                    tr
                        td #{item.properties.name}
                        td #{item.properties.author}
                        td #{item.properties.genre}
